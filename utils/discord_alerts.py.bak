#!/usr/bin/env python3
"""
utils/discord_alerts.py

Discord notifier for AllMight.
Reads .env file directly on every send -- no os.environ caching.

Webhooks:
  DISCORD_ALERT_WEBHOOK    -- EXECUTE events, urgent alerts
  DISCORD_DETAILED_WEBHOOK -- reports, daily summary
  DISCORD_TERMINAL_WEBHOOK -- heartbeat, process health

Usage:
    from utils.discord_alerts import discord
    discord.heartbeat("System alive")
    discord.execute_alert("arbitrum", "ETH/USDT", "+16.4bps", "$+1.22")
    discord.shadow_report(win_rate=72.0, trades=45, pnl=38.50, mvi_pass=False)
    discord.system_alert("Redis went stale")
    discord.daily_summary(scans=1440, executed=23, pnl=28.40, win_rate=69.6)
    discord.test()
"""

import json
import urllib.request
import urllib.error
from datetime import datetime, timezone
from pathlib import Path

# ── Colors ────────────────────────────────────────────────────────────────────
GREEN  = 0x00FF00
ORANGE = 0xFFA500
RED    = 0xFF0000
BLUE   = 0x0099FF
GOLD   = 0xFFD700

# ── Env loader ────────────────────────────────────────────────────────────────
def _read_env() -> dict:
    """Read .env file directly every call. Never uses os.environ cache."""
    env_file = Path(__file__).resolve().parent.parent / ".env"
    result = {}
    if not env_file.exists():
        return result
    for line in env_file.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, val = line.partition("=")
        key = key.strip()
        val = val.strip().strip("\"'")
        if key and val:
            result[key] = val
    return result

# ── Core sender ───────────────────────────────────────────────────────────────
def _send(channel: str, payload: dict) -> bool:
    """
    Send payload to Discord webhook.
    channel: 'alert' | 'detailed' | 'terminal'
    Reads URL fresh from .env on every call.
    """
    env = _read_env()

    enabled = env.get("DISCORD_NOTIFICATIONS_ENABLED", "true").lower() == "true"
    if not enabled:
        return True

    key_map = {
        "alert":    "DISCORD_ALERT_WEBHOOK",
        "detailed": "DISCORD_DETAILED_WEBHOOK",
        "terminal": "DISCORD_TERMINAL_WEBHOOK",
    }
    env_key = key_map.get(channel, "DISCORD_ALERT_WEBHOOK")
    url = env.get(env_key, "").strip()

    if not url or "YOUR_" in url or url == "****":
        print(f"[discord] WARNING: {env_key} not configured in .env")
        return False

    try:
        data = json.dumps(payload).encode("utf-8")
        req  = urllib.request.Request(
            url,
            data=data,
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=10) as resp:
            return True  # urllib raises on 4xx/5xx -- reaching here means success
    except urllib.error.HTTPError as e:
        print(f"[discord] HTTP {e.code}: {e.reason} | channel={channel} | url={url[:60]}")
        return False
    except Exception as e:
        print(f"[discord] send failed: {e}")
        return False

# ── Embed builder ─────────────────────────────────────────────────────────────
def _embed(title: str, description: str, color: int,
           fields: list = None, footer: str = "AllMight") -> dict:
    e = {
        "title":       title,
        "description": description,
        "color":       color,
        "timestamp":   datetime.now(timezone.utc).isoformat(),
        "footer":      {"text": footer},
    }
    if fields:
        e["fields"] = fields
    return e

# ── Alert interface ───────────────────────────────────────────────────────────
class DiscordAlerts:

    def heartbeat(self, message: str = "") -> bool:
        """Hourly health ping to TERMINAL channel."""
        trade_log = Path(__file__).resolve().parent.parent / "logs/shadow_trades.csv"
        trade_count = 0
        if trade_log.exists():
            with open(trade_log) as f:
                trade_count = max(0, sum(1 for _ in f) - 1)

        ts   = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
        desc = message or f"System running as of {ts}"
        embed = _embed(
            title       = "💚 AllMight Heartbeat",
            description = desc,
            color       = GREEN,
            fields      = [
                {"name": "Shadow trades", "value": str(trade_count), "inline": True},
                {"name": "Time",          "value": ts,               "inline": True},
            ],
            footer = "AllMight Terminal"
        )
        return _send("terminal", {"username": "AllMight", "embeds": [embed]})

    def execute_alert(self, chain: str, pair: str,
                      gross_bps: str, net_usd: str) -> bool:
        """Fire on every shadow EXECUTE decision. Goes to ALERT channel."""
        embed = _embed(
            title       = "✅ SHADOW EXECUTE",
            description = f"**{chain.upper()} {pair}**",
            color       = GOLD,
            fields      = [
                {"name": "Gross edge", "value": gross_bps,              "inline": True},
                {"name": "Net P&L",    "value": net_usd,                "inline": True},
                {"name": "Mode",       "value": "SHADOW -- no real tx", "inline": True},
            ],
            footer = "AllMight Shadow Mode"
        )
        return _send("alert", {"username": "AllMight", "embeds": [embed]})

    def shadow_report(self, win_rate: float, trades: int,
                      pnl: float, mvi_pass: bool) -> bool:
        """Periodic shadow summary. Goes to DETAILED channel."""
        gate  = "✅ PASS" if mvi_pass else "❌ FAIL"
        color = GREEN if mvi_pass else ORANGE
        embed = _embed(
            title       = "📊 Shadow Mode Report",
            description = f"MVI Gate: **{gate}**",
            color       = color,
            fields      = [
                {"name": "Win rate",      "value": f"{win_rate:.1f}%", "inline": True},
                {"name": "Trades",        "value": str(trades),        "inline": True},
                {"name": "Simulated P&L", "value": f"${pnl:.4f}",     "inline": True},
            ],
            footer = "AllMight Shadow Mode"
        )
        return _send("detailed", {"username": "AllMight", "embeds": [embed]})

    def system_alert(self, message: str, level: str = "WARNING") -> bool:
        """System-level alert. Goes to TERMINAL channel."""
        colors = {"WARNING": ORANGE, "ERROR": RED, "INFO": BLUE}
        emojis = {"WARNING": "⚠️",  "ERROR": "❌", "INFO": "ℹ️"}
        embed = _embed(
            title       = f"{emojis.get(level,'⚠️')} AllMight {level}",
            description = message,
            color       = colors.get(level, ORANGE),
            footer      = "AllMight Watchdog"
        )
        return _send("terminal", {"username": "AllMight", "embeds": [embed]})

    def daily_summary(self, scans: int, executed: int,
                      pnl: float, win_rate: float) -> bool:
        """Daily summary. Goes to DETAILED channel."""
        date_str = datetime.now(timezone.utc).strftime("%Y-%m-%d")
        embed = _embed(
            title       = f"📋 Daily Summary -- {date_str}",
            description = "Shadow mode 24-hour report",
            color       = BLUE,
            fields      = [
                {"name": "Scans",         "value": str(scans),         "inline": True},
                {"name": "EXECUTE",       "value": str(executed),      "inline": True},
                {"name": "SKIP",          "value": str(scans-executed),"inline": True},
                {"name": "Win rate",      "value": f"{win_rate:.1f}%", "inline": True},
                {"name": "Simulated P&L", "value": f"${pnl:.4f}",     "inline": True},
                {"name": "MVI Gate",
                 "value": "✅ PASS" if win_rate >= 60 else "❌ FAIL",
                 "inline": True},
            ],
            footer = "AllMight Daily Report"
        )
        return _send("detailed", {"username": "AllMight", "embeds": [embed]})

    def test(self) -> None:
        """Send test message to all three channels."""
        ts = datetime.now(timezone.utc).strftime("%H:%M UTC")

        print("Testing TERMINAL webhook...")
        ok = self.heartbeat(f"Discord test at {ts} -- all systems nominal")
        print("  OK" if ok else "  FAILED")

        print("Testing ALERT webhook...")
        ok = self.execute_alert("arbitrum", "ETH/USDT", "+16.4bps", "$+1.22")
        print("  OK" if ok else "  FAILED")

        print("Testing DETAILED webhook...")
        ok = self.shadow_report(win_rate=72.0, trades=45, pnl=38.50, mvi_pass=False)
        print("  OK" if ok else "  FAILED")


# Singleton
discord = DiscordAlerts()

if __name__ == "__main__":
    discord.test()
