const axios = require("axios");

async function getNetworkPerformance() {
    // Fetch and log performance metrics from each endpoint
    const responseTimes = await checkEndpoints(); // Fetch RPC performance
    console.log("Endpoint Latency:", responseTimes);
}

async function checkEndpoints() {
    const endpoints = [process.env.ETHEREUM_MAINNET_RPC_URL_1, process.env.POLYGON_MAINNET_RPC_URL_1];
    const responseTimes = {};
    for (const endpoint of endpoints) {
        const start = Date.now();
        try {
            await axios.get(endpoint);
            responseTimes[endpoint] = Date.now() - start;
        } catch (e) {
            responseTimes[endpoint] = "Failed";
        }
    }
    return responseTimes;
}

module.exports = { getNetworkPerformance };
