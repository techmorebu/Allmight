# --- MODE SETTINGS ---
# Set to either LIVE_FIRE for production or TEST_FIRE for testing
MODE=TEST_FIRE

# --- WALLET CONFIGURATION ---
# MetaMask Private Key (used for signing transactions). Securely store this value.
METAMASK_PRIVATE_KEY=your_metamask_private_key_here

# --- NETWORK CONFIGURATION: ETHEREUM ---
# Ethereum RPC URLs for mainnet and testnet (Alchemy or Infura recommended)
ALCHEMY_MAINNET_RPC_URL=https://eth-mainnet.alchemyapi.io/v2/YOUR_MAINNET_KEY
ALCHEMY_TESTNET_RPC_URL=https://eth-sepolia.alchemyapi.io/v2/YOUR_TEST_KEY

# --- NETWORK CONFIGURATION: POLYGON ---
# Polygon RPC URLs for mainnet and testnet
POLYGON_MAINNET_RPC_URL=https://polygon-rpc.com/
POLYGON_TESTNET_RPC_URL=https://rpc-mumbai.maticvigil.com/

# --- NETWORK CONFIGURATION: ZKSYNC ---
# zkSync RPC URLs for mainnet and testnet
ZKSYNC_MAINNET_RPC_URL=https://mainnet.era.zksync.io
ZKSYNC_TESTNET_RPC_URL=https://testnet.era.zksync.io

# --- FLASH LOAN PROVIDER ADDRESSES ---
# Flash loan provider addresses for Aave, MakerDAO, UniswapV3, and Balancer
# Mainnet and testnet addresses should be configured for each mode

# Aave addresses
AAVE_MAINNET_ADDRESS=0xAaveMainnetAddress
AAVE_TESTNET_ADDRESS=0xAaveTestnetAddress

# MakerDAO addresses
MAKERDAO_MAINNET_ADDRESS=0xMakerDAOMainnetAddress
MAKERDAO_TESTNET_ADDRESS=0xMakerDAOTestnetAddress

# Uniswap V3 addresses
UNISWAPV3_MAINNET_ADDRESS=0xUniswapV3MainnetAddress
UNISWAPV3_TESTNET_ADDRESS=0xUniswapV3TestnetAddress

# Balancer addresses
BALANCER_MAINNET_ADDRESS=0xBalancerMainnetAddress
BALANCER_TESTNET_ADDRESS=0xBalancerTestnetAddress

# --- DATA API KEYS ---
# API Keys for data aggregation sources like CoinGecko and CryptoCompare

# CoinGecko API Key
COINGECKO_API_KEY=your_coingecko_api_key_here

# CryptoCompare API Key
CRYPTOCOMPARE_API_KEY=your_cryptocompare_api_key_here

# --- FLASHBOTS RELAY URL ---
# Flashbots relay URL for private transactions on Ethereum (front-running protection)
FLASHBOTS_RELAY_URL=https://relay.flashbots.net
